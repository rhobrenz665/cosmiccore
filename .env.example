# Neon development branch. Pull real values with `neon env pull --service auth --service postgres`.
DATABASE_URL=postgresql://user:password@host-pooler/database
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database
NEON_AUTH_BASE_URL=https://your-branch.neonauth.region.aws.neon.tech/neondb/auth

# Generate locally with `openssl rand -base64 48`.
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
