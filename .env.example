# Neon development branch. Pull real values with `neon env pull --service auth --service postgres`.
DATABASE_URL=postgresql://user:password@host-pooler/database
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database
NEON_AUTH_BASE_URL=https://your-branch.neonauth.region.aws.neon.tech/neondb/auth

# Generate locally with `openssl rand -base64 48`.
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Required before feature mutations are enabled. Set explicit operator-approved
# nonnegative integer capacities; no global production defaults are assumed.
# Count/byte limits are lifetime live totals (notes include Trash).
# Mutations count is a fixed UTC-minute limit. 0 disables new consumption.
# COSMICCORE_GLOBAL_NOTES_COUNT_LIMIT=
# COSMICCORE_GLOBAL_NOTES_BYTES_LIMIT=
# COSMICCORE_GLOBAL_REFERENCES_COUNT_LIMIT=
# COSMICCORE_GLOBAL_REFERENCES_BYTES_LIMIT=
# COSMICCORE_GLOBAL_COLLECTIONS_COUNT_LIMIT=
# COSMICCORE_GLOBAL_TAGS_COUNT_LIMIT=
# COSMICCORE_GLOBAL_MUTATIONS_COUNT_LIMIT=

# Optional per-account bulk Markdown export limit per one-hour window. Defaults to 5.
# COSMICCORE_BULK_EXPORTS_PER_HOUR=5

# Enable only after verifying fresh Google confirmation and scheduling the worker
# against a database paired with its own Neon Auth branch.
# COSMICCORE_ACCOUNT_DELETION_ENABLED=false

# Worker-only credential and matching Neon project and branch IDs.
# NEON_DELETION_API_KEY=
# NEON_DELETION_PROJECT_ID=
# NEON_DELETION_BRANCH_ID=
