{
  "name": "cosmiccore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:https": "next dev --webpack --experimental-https",
    "build": "next build --webpack",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check-transactions": "node --experimental-strip-types scripts/check-db-transactions.mts",
    "db:check-ownership": "node --experimental-strip-types scripts/check-db-ownership.mts",
    "db:check-mutations": "node --experimental-strip-types scripts/check-db-mutations.mts",
    "test:mutation-rules": "node --experimental-strip-types --test scripts/mutation-rules.test.mts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:check-acceptance": "node --experimental-strip-types scripts/check-db-acceptance.mts",
    "test:connection-lifecycle": "node --experimental-strip-types --test scripts/connection-lifecycle.test.mts",
    "db:cleanup-acceptance": "node --experimental-strip-types scripts/cleanup-db-acceptance.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@neon/auth": "^0.8.2",
    "@neondatabase/serverless": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
